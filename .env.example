# ===========================================
# OS Acoustic Database Backend - 環境變數範本
# ===========================================
# 複製此檔案為 .env 並填入實際值

# ----- PostgreSQL -----
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_IP_ADDRESS=db
POSTGRES_PORT=5432
POSTGRES_PORT_OUT=5432

# ----- FastAPI App -----
APP_PORT=8000
APP_PORT_OUT=8000
SECRET_KEY=your_jwt_secret_key

# ----- MinIO (Object Storage) -----
# Docker 內部使用服務名稱 "minio"
MINIO_IP_ADDRESS=minio
MINIO_PORT=9000
MINIO_PORT_OUT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET_NAME=data
# 外部存取用 URL（讓 presigned URL 可供 Docker 外部使用）
# 格式：http://<宿主機IP或域名>:<port>
# 例：http://192.168.1.100:9000
# 不設定時回退至內部位址 (MINIO_IP_ADDRESS:MINIO_PORT)
# MINIO_EXTERNAL_URL=http://192.168.1.100:9000
